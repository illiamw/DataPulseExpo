{
  "expo": {
    "name": "datapulse",
    "slug": "datapulse",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "datapulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.williamferreira.datapulse",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.williamferreira.datapulse",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo-google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_ZGl2ZXJzZS1ibHVlZ2lsbC0yNzExLmNsZXJrLmFjY291bnRzLmRldiQ",
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "776727460327-ek4jhmqqthufr7g30k8sc5ogihs7gs8g.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID": "776727460327-p4k3jfi8002ib5djhmuib29dhhk8l4pv.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "2c916419-7555-4876-a843-4d26a809ac79"
      }
    },
    "owner": "illiamw"
  }
}
